{% extends "lk/base.html" %}
{% block title %}{{ post.title }} – Sri Lanka Travel{% endblock %}
{% block content %}
<main class="wrap" style="max-width:820px">
  <a class="btn" href="{% url 'home' %}">← Back to stories</a>
  <h1 style="margin:18px 0;color:var(--g1);font-size:clamp(2rem,6vw,3.2rem)">{{ post.title }}</h1>
  {% if post.image %}<img src="{{ post.image.url }}" alt="" style="width:100%;max-height:420px;object-fit:cover;border-radius:18px;margin-bottom:18px">{% endif %}
  <div class="card"><div class="cbody">{{ post.content|linebreaks }}</div></div>
</main>
{% endblock %}
