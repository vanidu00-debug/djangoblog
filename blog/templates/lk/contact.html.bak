{% extends "lk/base.html" %}
{% block title %}Contact – Sri Lanka Travel{% endblock %}
{% block content %}
<main class="wrap" style="max-width:640px">
  <h2 class="title">Contact</h2>
  <p class="sub">Send us a message</p>
  <div class="card"><div class="cbody">
    {% if sent %}
      <div class="stat">Thank you! 🌴</div><p>Your message was received.</p>
    {% else %}
      <form method="post">{% csrf_token %}
        <label>Name</label><input name="name" required>
        <label>Email</label><input name="email" type="email" required>
        <label>Message</label><textarea name="message" rows="5" required></textarea>
        <button class="btn" type="submit">Send</button>
      </form>
    {% endif %}
  </div></div>
</main>
{% endblock %}
