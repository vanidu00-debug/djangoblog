import random
import time

from django.core.cache import cache
from django.core.paginator import Paginator
from django.http import Http404, JsonResponse
from django.shortcuts import get_object_or_404, render

from .models import Post

DESTINATIONS = {
    "beaches": {"name": "Beaches", "emoji": "🏖️", "photo": "images/photo1.jpg", "best": "November to April (south and west coast)",
                "text": "Golden sand, surf and sunsets. Mirissa for whale watching, Unawatuna for calm water, Arugam Bay for surfing."},
    "mountains": {"name": "Mountains", "emoji": "⛰️", "photo": "images/photo2.jpg", "best": "January to April",
                  "text": "Tea hills, waterfalls and misty trails. Ride the train to Ella and hike Little Adam's Peak."},
    "wildlife": {"name": "Wildlife", "emoji": "🐘", "photo": "images/photo3.jpg", "best": "February to July (Yala)",
                 "text": "Leopards in Yala, elephants in Udawalawe and Minneriya, and blue whales off the south coast."},
    "culture": {"name": "Culture", "emoji": "🛕", "photo": "images/photo4.jpg", "best": "January to April",
                "text": "Climb Sigiriya, visit the Temple of the Tooth in Kandy and explore ancient Anuradhapura."},
    "food": {"name": "Food", "emoji": "🍛", "photo": "images/photo5.jpg", "best": "All year",
             "text": "Rice and curry, kottu roti, hoppers and fresh seafood. Try street food in Colombo."},
}
ORDER = list(DESTINATIONS)


def post_list(request):
    posts = Paginator(Post.objects.all().order_by("-id"), 6)
    page_obj = posts.get_page(request.GET.get("page"))
    return render(request, "lk/home.html", {"page_obj": page_obj})


def post_detail(request, slug):
    post = get_object_or_404(Post, slug=slug)
    return render(request, "lk/post_detail.html", {"post": post})


def about(request):
    return render(request, "lk/about.html")


def contact(request):
    sent = False
    if request.method == "POST":
        # Message is printed in the terminal. Later you can save it or e-mail it.
        print("CONTACT:", request.POST.get("name"), request.POST.get("email"), request.POST.get("message"))
        sent = True
    return render(request, "lk/contact.html", {"sent": sent})


def destination(request, slug):
    d = DESTINATIONS.get(slug)
    if d is None:
        raise Http404("Unknown destination")
    nxt = ORDER[(ORDER.index(slug) + 1) % len(ORDER)]
    return render(request, "lk/destination.html", {"d": d, "slug": slug, "next": nxt})


def live_data(request):
    return JsonResponse({"values": [random.randint(5, 100) for _ in range(5)]})


def destination_live(request, slug):
    if slug not in DESTINATIONS:
        raise Http404
    return JsonResponse({"value": random.randint(5, 100)})


def online(request):
    sid = request.GET.get("sid", "")[:40]
    users = cache.get("online", {})
    now = time.time()
    if sid:
        users[sid] = now
    users = {k: v for k, v in users.items() if now - v < 15}
    cache.set("online", users, 60)
    return JsonResponse({"online": len(users)})
